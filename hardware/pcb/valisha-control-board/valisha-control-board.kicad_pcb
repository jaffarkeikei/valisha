      (drill 3.2)
      (layers "*.Cu" "*.Mask")
      (uuid "mh04-pad")
    )
  )

  ; ============================================
  ; SILKSCREEN TEXT
  ; ============================================

  (gr_text "VALISHA v1.0"
    (at 50 3)
    (layer "F.SilkS")
    (uuid "txt01-0000-0000-0000-000000000001")
    (effects
