      (size 3.2 3.2)
      (drill 3.2)
      (layers "*.Cu" "*.Mask")
      (uuid "mh03-pad")
    )
  )

  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (uuid "mh04-0000-0000-0000-000000000001")
    (at 95 95)
    (property "Reference" "H4"
      (at 0 -3 0)
      (layer "F.SilkS")
