  ; ============================================
  ; COPPER ZONE (GND on Bottom Layer)
  ; ============================================
  (zone
    (net 1)
    (net_name "GND")
    (layer "B.Cu")
    (uuid "zone-gnd-0000-0000-000000000001")
    (hatch edge 0.5)
    (connect_pads
      (clearance 0.25)
    )
    (min_thickness 0.25)
    (filled_areas_thickness no)
    (fill yes
      (thermal_gap 0.5)
      (thermal_bridge_width 0.5)
    )
    (polygon
      (pts
        (xy 0 0)
        (xy 100 0)
        (xy 100 100)
        (xy 0 100)
      )
    )
  )

)
